-- TAB SCROLLING FIX
local function createTabScroll(parent)
    local s = Instance.new("ScrollingFrame", parent)
    s.Size = UDim2.new(1, 0, 1, 0)
    s.BackgroundTransparency = 1
    s.ScrollBarThickness = 2
    s.CanvasSize = UDim2.new(0, 0, 0, 0)
    local l = Instance.new("UIListLayout", s)
    l.Padding = UDim.new(0, 8)
    -- AUTO SCROLL SCRIPT
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        s.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 20)
    end)
    return s
end

local TabMain = createTabScroll(Content)
local TabTL = createTabScroll(Content) TabTL.Visible = false
local TabDB = createTabScroll(Content) TabDB.Visible = false

local function createTabBtn(name, yPos, frameToShow)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(1, -12, 0, 32)
    btn.Position = UDim2.new(0, 6, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = name
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function()
        TabMain.Visible = false TabTL.Visible = false TabDB.Visible = false
        frameToShow.Visible = true
    end)
end

createTabBtn("HOME", 10, TabMain)
createTabBtn("SAVE CP", 45, TabTL)
createTabBtn("DATABASE", 80, TabDB)

-- ==========================================
-- HOME CONTENT
-- ==========================================
local function createInput(parent, labelTxt, default, callback)
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(1, -5, 0, 26)
    f.BackgroundTransparency = 1
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(0.6, 0, 1, 0)
    l.Text = labelTxt
    l.TextColor3 = Color3.fromRGB(220, 220, 220)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.BackgroundTransparency = 1
    local b = Instance.new("TextBox", f)
    b.Size = UDim2.new(0.3, 0, 0.9, 0)
    b.Position = UDim2.new(0.7, 0, 0, 0)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.Text = tostring(default)
    b.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", b)
    b.FocusLost:Connect(function() callback(tonumber(b.Text)) end)
end

createInput(TabMain, "SPEED", 16, function(v) _G.RunSpeed = v end)
createInput(TabMain, "JUMP", 50, function(v) _G.JumpPower = v end)
createInput(TabMain, "DELAY LOOP", 3, function(v) _G.TPDelay = v end)

local Split = Instance.new("Frame", TabMain)
Split.Size = UDim2.new(1, -5, 0, 85)
Split.BackgroundTransparency = 1

local function createSplitBox(parent, xPos, title, color, callback)
    local s = Instance.new("Frame", parent)
    s.Size = UDim2.new(0.48, 0, 1, 0)
    s.Position = UDim2.new(xPos, 0, 0, 0)
    s.BackgroundTransparency = 1
    local box = Instance.new("TextBox", s)
    box.Size = UDim2.new(1, 0, 0, 28)
    box.Position = UDim2.new(0, 0, 0, 15)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    box.PlaceholderText = "Nama..."
    box.TextColor3 = Color3.new(1,1,1)
    box.TextSize = 10
    Instance.new("UICorner", box)
    local btn = Instance.new("TextButton", s)
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Position = UDim2.new(0, 0, 0, 48)
    btn.BackgroundColor3 = color
    btn.Text = title
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function() callback(box) end)
end

createSplitBox(Split, 0, "SAVE MANUAL", Color3.fromRGB(0, 150, 100), function(b)
    local hrp = Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        table.insert(autoCoords, {Name = b.Text ~= "" and b.Text or "Manual", X = hrp.Position.X, Y = hrp.Position.Y, Z = hrp.Position.Z})
        saveToFile() refreshLists() b.Text = ""
    end
end)

createSplitBox(Split, 0.52, "SAVE CP TO DB", Color3.fromRGB(0, 120, 200), function(b)
    if #autoCoords > 0 then
        table.insert(mountainData, {MountainName = b.Text ~= "" and b.Text or "Gunung", Coords = autoCoords})
        autoCoords = {} 
        saveToFile() refreshLists() b.Text = ""
    end
end)

local function createToggle(name, callback)
    local b = Instance.new("TextButton", TabMain)
    b.Size = UDim2.new(1, -5, 0, 32)
    b.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
    b.Text = name .. ": OFF"
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(function()
        local state = callback()
        b.Text = name .. ": " .. (state and "ON" or "OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(180, 0, 0)
    end)
end

createToggle("AUTO SAVE CP", function() _G.AutoSaveCP = not _G.AutoSaveCP return _G.AutoSaveCP end)
createToggle("AUTO LOOP TL", function() _G.LoopCP = not _G.LoopCP return _G.LoopCP end)

-- ==========================================
-- LIST RENDERING
-- ==========================================
function refreshLists()
    for _, c in ipairs(TabTL:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    for _, c in ipairs(TabDB:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end

    for i, d in ipairs(autoCoords) do
        local f = Instance.new("Frame", TabTL)
        f.Size = UDim2.new(1, -5, 0, 42)
        f.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
        Instance.new("UICorner", f)
        local t = Instance.new("TextLabel", f)
        t.Size = UDim2.new(0.65, 0, 1, 0)
        t.Position = UDim2.new(0, 10, 0, 0)
        t.Text = d.Name .. " (Saved)\n" .. math.round(d.X) .. ", " .. math.round(d.Y) .. ", " .. math.round(d.Z)
        t.TextColor3 = Color3.new(1,1,1)
        t.TextSize = 9
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.BackgroundTransparency = 1
        local tp = Instance.new("TextButton", f)
        tp.Size = UDim2.new(0, 35, 0, 28)
        tp.Position = UDim2.new(1, -75, 0.5, -14)
        tp.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        tp.Text = "TP"
        tp.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", tp)
        tp.MouseButton1Click:Connect(function()
            local hrp = Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then isTeleporting = true hrp.CFrame = CFrame.new(d.X, d.Y, d.Z) task.wait(0.5) isTeleporting = false end
        end)
        local del = Instance.new("TextButton", f)
        del.Size = UDim2.new(0, 30, 0, 28)
        del.Position = UDim2.new(1, -35, 0.5, -14)
        del.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        del.Text = "X"
        Instance.new("UICorner", del)
        del.MouseButton1Click:Connect(function() table.remove(autoCoords, i) saveToFile() refreshLists() end)
    end

    for i, m in ipairs(mountainData) do
        local f = Instance.new("Frame", TabDB)
        f.Size = UDim2.new(1, -5, 0, 42)
        f.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        Instance.new("UICorner", f)
        local t = Instance.new("TextLabel", f)
        t.Size = UDim2.new(0.65, 0, 1, 0)
        t.Position = UDim2.new(0, 10, 0, 0)
        t.Text = m.MountainName .. " (" .. #m.Coords .. " CP)"
        t.TextColor3 = Color3.fromRGB(0, 255, 180)
        t.Font = Enum.Font.GothamBold
        t.TextSize = 10
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.BackgroundTransparency = 1
        local set = Instance.new("TextButton", f)
        set.Size = UDim2.new(0, 40, 0, 28)
        set.Position = UDim2.new(1, -80, 0.5, -14)
        set.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
        set.Text = "SET"
        set.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", set)
        set.MouseButton1Click:Connect(function()
            autoCoords = {}
            for _, c in ipairs(m.Coords) do table.insert(autoCoords, c) end
            saveToFile() refreshLists()
        end)
        local del = Instance.new("TextButton", f)
        del.Size = UDim2.new(0, 30, 0, 28)
        del.Position = UDim2.new(1, -35, 0.5, -14)
        del.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        del.Text = "X"
        Instance.new("UICorner", del)
        del.MouseButton1Click:Connect(function() table.remove(mountainData, i) saveToFile() refreshLists() end)
    end
end
refreshLists()

-- ==========================================
-- UNIVERSAL SCANNER LOOP
-- ==========================================
task.spawn(function()
    while task.wait(0.2) do
        local char = Players.LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum then 
            hum.WalkSpeed = _G.RunSpeed 
            hum.JumpPower = _G.JumpPower 
            if _G.AutoSaveCP and hum.Health > 0 and not isTeleporting then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, p in ipairs(hrp:GetTouchingParts()) do
                        local pN = p.Name:lower()
                        -- UNIVERSAL FILTER: Cek Nama atau adanya TouchInterest
                        local isCP = pN:find("checkpoint") or p.Name:match("^%d+$") or p:FindFirstChild("TouchInterest")
                        local isBad = pN:find("fallen") or pN:find("kill") or pN:find("lava") or pN:find("summit")
                        
                        if isCP and not isBad then
                            local pos = hrp.Position
                            local dupe = false
                            for _, v in ipairs(autoCoords) do 
                                if (Vector3.new(v.X,v.Y,v.Z)-pos).Magnitude < 15 then dupe=true break end 
                            end
                            if not dupe then
                                table.insert(autoCoords, {Name = "CP "..p.Name, X = pos.X, Y = pos.Y, Z = pos.Z})
                                saveToFile() refreshLists()
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(_G.TPDelay)
        if _G.LoopCP and #autoCoords > 0 then
            for _, d in ipairs(autoCoords) do
                if not _G.LoopCP then break end
                local hrp = Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.CFrame = CFrame.new(d.X, d.Y, d.Z) end
                task.wait(_G.TPDelay)
            end
        end
    end
end)
