local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

if CoreGui:FindFirstChild("LiviaUltimateV1") then CoreGui.LiviaUltimateV1:Destroy() end

local sg = Instance.new("ScreenGui", CoreGui)
sg.Name = "LiviaUltimateV1"
sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- ==========================================
-- DATABASE SYSTEM
-- ==========================================
local fileName = "Livia_Auto_Summit.json"
local autoCoords = {}   
local mountainData = {} 

local function saveToFile()
    local data = HttpService:JSONEncode({Auto = autoCoords, Mountains = mountainData})
    writefile(fileName, data)
end

local function loadFromFile()
    if isfile(fileName) then
        local status, data = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if status then
            autoCoords = data.Auto or {}
            mountainData = data.Mountains or {}
        end
    end
end
pcall(loadFromFile)

_G.RunSpeed = 16
_G.JumpPower = 50
_G.AutoSaveCP = false
_G.LoopCP = false
_G.TPDelay = 3
local isTeleporting = false

